###############################################################################
# Secrets et config locale
# appsettings.json et appsettings.Development.json restent versionnes.
# Les cles (DeepL, Azure, connexion BDD) vont dans un fichier *.Local.json
# ignore, ou dans `dotnet user-secrets`.
###############################################################################
appsettings.Local.json
appsettings.*.Local.json
*.local.json
.env
.env.*
!.env.example
secrets.json

###############################################################################
# ScanTrad : modeles IA
# Les poids ONNX (detection de texte, OCR, inpainting) pesent des dizaines
# ou centaines de Mo. On ne les versionne pas : script de telechargement ou
# Git LFS si vraiment necessaire.
###############################################################################
# Attention : sur Windows git ignore la casse, donc une regle « models/ » nue
# avalerait aussi les dossiers « Models/ » du code C#. On limite a la racine.
/models/
*.onnx
*.onnx.data
*.pt
*.pth
*.pdparams
*.safetensors
*.gguf

###############################################################################
# ScanTrad : donnees utilisateur
# Scans importes, images nettoyees (inpainting) et rendus finaux sont des
# donnees de run, jamais du code source.
###############################################################################
storage/
uploads/
media/
output/
cleaned/
rendered/

# Echantillons de test : on autorise un jeu minimal pour reproduire un bug.
!tests/fixtures/**
!**/samples/**

###############################################################################
# Bases de donnees locales
###############################################################################
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

###############################################################################
# Publication / conteneurs
###############################################################################
[Pp]ublish/
*.[Pp]ublish.xml
*.pubxml
*.pubxml.user
*.azurePubxml
docker-compose.override.yml

###############################################################################
# Front (si ajout d'un projet JS plus tard)
###############################################################################
node_modules/
dist/
.next/
.nuxt/
*.tsbuildinfo

